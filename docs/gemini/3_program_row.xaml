<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        Style="{StaticResource RowStyle}" Height="56" Padding="12,0">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="120"/>
        </Grid.ColumnDefinitions>

        <!-- 체크박스 -->
        <CheckBox x:Name="cb" Grid.Column="0" Style="{StaticResource FluentCheck}" HorizontalAlignment="Center"/>

        <!-- 아이콘 영역 -->
        <Grid Grid.Column="1">
            <!-- 기본 글자 타일 (아이콘 없을 때 대비) -->
            <Border x:Name="tile" Width="38" Height="38" Background="#E5E5E5" CornerRadius="8" HorizontalAlignment="Left">
                <TextBlock Text="C" FontSize="16" FontWeight="Bold" Foreground="#616161" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <!-- 윈도우 앱 아이콘 렌더링용 (기본 숨김) -->
            <Image x:Name="img" Width="32" Height="32" HorizontalAlignment="Left" Margin="3,0,0,0" Visibility="Collapsed"/>
        </Grid>

        <!-- 이름 및 카테고리 -->
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,16,0">
            <TextBlock Text="Google Chrome" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="브라우저" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Winget ID -->
        <TextBlock Grid.Column="3" Text="Google.Chrome" FontFamily="Consolas, Malgun Gothic" FontSize="13" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>

        <!-- 상태 배지 -->
        <Border x:Name="pill" Grid.Column="4" Background="#EBEBEB" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock x:Name="st" Text="확인 중…" FontSize="11" FontWeight="SemiBold" Foreground="#5D5D5D"/>
        </Border>
    </Grid>
</Border>