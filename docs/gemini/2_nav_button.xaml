<Button xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        Style="{StaticResource NavButton}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <!-- 선택 표시기 (기본 Collapsed, 선택 시 Visible) -->
        <Border x:Name="ind" Width="3" Height="16" Background="{StaticResource AccentColor}" CornerRadius="1.5" Margin="-8,0,8,0" Visibility="Collapsed"/>
        
        <TextBlock x:Name="nm" Grid.Column="1" Text="카테고리명" FontSize="14" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
        
        <TextBlock Grid.Column="2" Text="3" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0"/>
    </Grid>
</Button>