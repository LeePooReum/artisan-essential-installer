<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="필수 프로그램 설치 도구" 
        Width="1120" Height="740" 
        MinWidth="920" MinHeight="560" 
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic">

    <Window.Resources>
        <!-- 색상 팔레트 -->
        <SolidColorBrush x:Key="AppBackground" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="ContentBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentColor" Color="#005FB8"/>
        <SolidColorBrush x:Key="AccentHover" Color="#0053A0"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#616161"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E5E5E5"/>
        <SolidColorBrush x:Key="HoverColor" Color="#F4F4F4"/>

        <!-- 기본 텍스트 스타일 -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 스크롤바 스타일 (간략화된 Fluent) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#C0C0C0" CornerRadius="4" Margin="2,0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- 카테고리 네비게이션 버튼 스타일 -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Margin="12,2">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource HoverColor}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- 텍스트박스 스타일 -->
        <Style x:Key="FluentTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FBFBFB"/>
            <Setter Property="BorderBrush" Value="#E5E5E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- 체크박스 스타일 -->
        <Style x:Key="FluentCheck" TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="chkBorder" Width="20" Height="20" BorderBrush="#8A8A8A" BorderThickness="1.5" CornerRadius="4" Background="#FFFFFF">
                            <Path x:Name="chkPath" Visibility="Collapsed" Data="M 4 10 L 8 14 L 16 5" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="chkBorder" Property="Background" Value="{StaticResource AccentColor}"/>
                            <Setter TargetName="chkBorder" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                            <Setter TargetName="chkPath" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="chkBorder" Property="BorderBrush" Value="{StaticResource TextSecondary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- 일반 버튼 스타일 -->
        <Style x:Key="StandardBtn" TargetType="Button">
            <Setter Property="Background" Value="#FBFBFB"/>
            <Setter Property="BorderBrush" Value="#D1D1D1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F4F4F4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- 강조 버튼 스타일 (설치) -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource StandardBtn}">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- 프로그램 행 컨테이너 스타일 -->
        <Style x:Key="RowStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 왼쪽 사이드바 -->
        <Grid Grid.Column="0" Background="{StaticResource AppBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 로고 및 앱 타이틀 -->
            <StackPanel Grid.Row="0" Margin="20,24,20,16">
                <Border Width="40" Height="40" Background="{StaticResource AccentColor}" CornerRadius="8" HorizontalAlignment="Left" Margin="0,0,0,12">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="필수 프로그램 설치 도구" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBlock Text="by Artisan" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>

            <!-- 카테고리 목록 패널 (ScrollViewer 적용) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                <StackPanel x:Name="NavPanel" Margin="0"/>
            </ScrollViewer>

            <!-- Winget 상태 표시 카드 -->
            <Border Grid.Row="2" Margin="16,10,16,16" Padding="12" Background="#FFFFFF" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="winget 상태" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Ellipse x:Name="WgDot" Width="8" Height="8" Fill="#107C10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="WgText" Text="사용 가능 v1.12" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 오른쪽 본문 -->
        <Border Grid.Column="1" Background="{StaticResource ContentBackground}" CornerRadius="8,0,0,0" BorderBrush="{StaticResource BorderColor}" BorderThickness="1,1,0,0">
            <Grid Margin="32,24,32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 헤더 영역 (타이틀, 설명, 검색창) -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="CatTitle" Text="전체 (35)" FontSize="28" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="설치할 프로그램을 골라주세요. 이미 설치된 프로그램은 '설치됨'으로 표시됩니다." Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                    </StackPanel>
                    
                    <!-- 검색창 -->
                    <Grid Grid.Column="1" VerticalAlignment="Top" Height="36">
                        <TextBox x:Name="SearchBox" Style="{StaticResource FluentTextBox}" Padding="32,0,10,0"/>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextSecondary}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock x:Name="SearchHint" Text="프로그램 검색" Foreground="#999999" Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Grid>

                <!-- 리스트 헤더 -->
                <Grid Grid.Row="1" Margin="12,0,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="AllCheck" Style="{StaticResource FluentCheck}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="프로그램 이름" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                    <TextBlock Grid.Column="2" Text="winget ID" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                    <TextBlock Grid.Column="3" Text="상태" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                </Grid>
                <Border Grid.Row="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Margin="0,0,0,-8" VerticalAlignment="Bottom"/>

                <!-- 프로그램 목록 -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                        <StackPanel x:Name="ListPanel"/>
                    </ScrollViewer>
                    
                    <!-- 검색 결과 없음 안내 (기본 숨김) -->
                    <TextBlock x:Name="EmptyText" Text="검색 결과가 없습니다" FontSize="16" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>

                <!-- 하단 컨트롤 바 -->
                <Grid Grid.Row="3" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 경로 설정 -->
                    <Grid Grid.Column="0" Margin="0,0,24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Margin="0,0,8,0">
                            <TextBox x:Name="PathBox" Style="{StaticResource FluentTextBox}" Height="36"/>
                            <TextBlock x:Name="PathHint" Text="기본 경로에 설치 (경로 입력 시 변경됨)" Foreground="#999999" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                        <Button x:Name="BrowseBtn" Grid.Column="1" Content="찾아보기" Style="{StaticResource StandardBtn}" Height="36"/>
                    </Grid>

                    <!-- 액션 버튼 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SelText" Text="0개 선택됨" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <Button x:Name="LogBtn" Content="로그" Style="{StaticResource StandardBtn}" Margin="0,0,12,0" Height="36"/>
                        <Button x:Name="InstallBtn" Style="{StaticResource PrimaryBtn}" Height="36" MinWidth="160">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="InstallText" Text="선택한 프로그램 설치" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>